<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="https://groundworkcafe.pk{{ canonicalUrl }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Groundwork">
  <meta property="og:url" content="https://groundworkcafe.pk{{ canonicalUrl }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:image" content="https://groundworkcafe.pk{{ ogImage | default('/images/og-default.jpg') }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/global.css">
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to content</a>

  {% include "nav.html" %}

  {{ content | safe }}

  {% include "footer.html" %}

  <a href="#" class="back-to-top" id="backToTop" aria-label="Back to top">↑</a>

  <script src="/js/nav.js" defer></script>
  <script src="/js/main.js" defer></script>
  {% if pageScript %}
  <script src="{{ pageScript }}" defer></script>
  {% endif %}

</body>
</html>
