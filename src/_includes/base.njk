<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/global.css">
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to content</a>

  {% include "nav.html" %}

  {{ content | safe }}

  {% include "footer.html" %}

  <a href="#" class="back-to-top" id="backToTop" aria-label="Back to top">↑</a>

  <script src="/js/nav.js" defer></script>
  <script src="/js/main.js" defer></script>
  {% if pageScript %}
  <script src="{{ pageScript }}" defer></script>
  {% endif %}

</body>
</html>
